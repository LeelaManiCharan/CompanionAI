# Copy to .env.local and fill in. .env.local is gitignored; never commit real values.

# Supabase project URL: Supabase dashboard > Project Settings > API (or "Connect") > Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Supabase anon (public) key: same page > Project API keys > anon / publishable key. Never put the service_role key here.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Gemini API key (server-only, never prefix with NEXT_PUBLIC_): https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here
# Gemini model id: see https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-flash-latest
# Comma-separated models tried in order when one hits its quota (429) or is not found (404).
# gemini-flash-lite-latest has a separate free-tier quota from gemini-flash-latest.
GEMINI_FALLBACK_MODELS=gemini-flash-lite-latest
# Cheaper model used first for background tasks (memory/reminder extraction, summaries, connection tests).
GEMINI_LITE_MODEL=gemini-flash-lite-latest
